# .env.example
# Copy this file to .env and fill in values for local development.
# The real .env is gitignored — never commit it.
# All variables are required unless marked optional.

# ── Monolith database ─────────────────────────────────────────────
MONOLITH_DB_HOST=localhost
MONOLITH_DB_PORT=5436
MONOLITH_DB_NAME=monolith_db
MONOLITH_DB_USER=stash_monolith
MONOLITH_DB_PASSWORD=change_me_monolith

# ── Payments database ─────────────────────────────────────────────
PAYMENTS_DB_USER=stash_payments
PAYMENTS_DB_PASSWORD=change_me_payments

# ── KYC database ──────────────────────────────────────────────────
KYC_DB_USER=stash_kyc
KYC_DB_PASSWORD=change_me_kyc

# ── Audit database ────────────────────────────────────────────────
AUDIT_DB_USER=stash_audit
AUDIT_DB_PASSWORD=change_me_audit
# Read-only dashboard role password — created by
# infra/docker/postgres/audit-db-init.sql on first container start. Must
# match the literal password in that file (ro_local_pass) for local dev.
AUDIT_READONLY_DB_PASSWORD=ro_local_pass

# ── RabbitMQ ──────────────────────────────────────────────────────
RABBITMQ_USER=stash
RABBITMQ_PASSWORD=change_me_rabbitmq

# ── Internal service-to-service auth ──────────────────────────────
# Shared secret for /internal/** calls between services. Any value works
# for local dev as long as it's the same across all services; production
# must set a real secret.
INTERNAL_SERVICE_TOKEN=local-dev-internal-service-token

# ── Paystack (payments-service) ───────────────────────────────────
# sk_test_... for test mode. Only documented before in
# payments-service/.env.example — required (no default) but missing here,
# so payments-service failed to boot when run via the root-level
# start-services scripts. See docs/hands-on-testing-findings.md Finding 3.
PAYSTACK_SECRET_KEY=sk_test_change_me_paystack
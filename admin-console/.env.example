# Copy to .env.local for local development.
# Never commit .env.local
#
# WARNING: All VITE_-prefixed variables are bundled into client JS
# and visible to anyone via browser dev tools. Never put secrets here.

VITE_API_URL=http://localhost:8080
VITE_ENV=development

# KYC Service URL (separate from monolith for admin calls)
VITE_KYC_API_URL=http://localhost:8082

# Audit Service URL (separate microservice, own port — v0.5-033)
VITE_AUDIT_API_URL=http://localhost:8083

# Placeholder admin token — matches KYC_PLACEHOLDER_ADMIN_TOKEN in kyc-service
VITE_PLACEHOLDER_ADMIN_TOKEN=local-dev-admin-token-not-for-production

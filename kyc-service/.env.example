# kyc-service/.env.example

KYC_DB_HOST=localhost
KYC_DB_PORT=5434
KYC_DB_NAME=kyc_db
KYC_DB_USER=stash_kyc
KYC_DB_PASSWORD=change_me_kyc

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=stash
RABBITMQ_PASSWORD=change_me_rabbitmq

GHANA_CARD_ENCRYPTION_KEY=change_me_base64_32_bytes
KYC_STORAGE_PROVIDER=local
KYC_LOCAL_STORAGE_PATH=/tmp/stash-kyc-storage
STASH_KYC_BASE_URL=http://localhost:8082

SPRING_PROFILES_ACTIVE=local
KYC_STUB_TEST_APPROVE_NUMBERS=GHA-000000001-1,GHA-000000002-2,GHA-000000003-3
KYC_PLACEHOLDER_ADMIN_TOKEN=change_me_placeholder_admin_token
# mobile/.env.example
# Copy to .env.local for local development.
# Never commit .env.local

# Backend API URL — points to monolith (KYC routes are proxied to kyc-service)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# App environment
EXPO_PUBLIC_ENV=development

# Support inbox for mailto: links (KYC rejection screen, etc.)
EXPO_PUBLIC_SUPPORT_EMAIL=support@stash.app

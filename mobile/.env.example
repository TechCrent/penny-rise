# mobile/.env.example
# Copy to .env.local for local development.
# Never commit .env.local

# Backend API URL — use your PC's LAN IPv4 when testing on a physical device (e.g. http://192.168.1.5:8080)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Pins the Metro/Expo dev-server URL (exp://...) to this IP instead of
# Expo CLI's own LAN-address autodetection, which can be unreliable on
# machines with multiple non-loopback network interfaces (VPNs, WSL,
# VirtualBox, etc.) and silently falls back to 127.0.0.1 when it fails.
# Should match the IP used above. start-mobile-lan.ps1 keeps this in sync
# automatically.
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.5

# App environment
EXPO_PUBLIC_ENV=development

# Support inbox for mailto: links (KYC rejection screen, etc.)
EXPO_PUBLIC_SUPPORT_EMAIL=support@pennyrise.app

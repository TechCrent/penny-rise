{
  "name": "@stash/mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "cross-env CI=false expo start --port 19000 --lan",
    "start:tunnel": "cross-env CI=false expo start --port 19000 --tunnel",
    "android": "cross-env CI=false expo start --android --port 19000 --lan",
    "ios": "cross-env CI=false expo start --ios --port 19000 --lan",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "expo": "~56.0.11",
    "expo-splash-screen": "^56.0.10",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "prettier": "^3.2.5",
    "typescript": "~6.0.3"
  },
  "private": true
}

{
  "name": "@stash/mobile",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "main": "index.ts",
  "scripts": {
    "start": "cross-env CI=false expo start --port 19000 --lan",
    "start:tunnel": "cross-env CI=false expo start --port 19000 --tunnel",
    "android": "cross-env CI=false expo start --android --port 19000 --lan",
    "ios": "cross-env CI=false expo start --ios --port 19000 --lan",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "typecheck": "tsc --noEmit",
    "test": "jest --watchAll=false"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@hookform/resolvers": "^5.4.0",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.18.1",
    "expo": "~54.0.10",
    "expo-camera": "^56.0.8",
    "expo-crypto": "^56.0.4",
    "expo-file-system": "^56.0.8",
    "expo-image-picker": "^56.0.18",
    "expo-secure-store": "^56.0.4",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-hook-form": "^7.80.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-preset-expo": "~54.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.14",
    "prettier": "^3.2.5",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}

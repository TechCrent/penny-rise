# monolith/.env.example
# Copy to monolith/.env for local development.
# Real .env is gitignored.

MONOLITH_DB_HOST=localhost
MONOLITH_DB_PORT=5436
MONOLITH_DB_NAME=monolith_db
MONOLITH_DB_USER=stash_monolith
MONOLITH_DB_PASSWORD=change_me_monolith

SPRING_PROFILES_ACTIVE=local

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=stash
RABBITMQ_PASSWORD=change_me_rabbitmq

# Internal kyc-service URL (monolith proxies /api/v1/kyc/** for mobile)
KYC_SERVICE_URL=http://localhost:8082

# Email
STASH_EMAIL_PROVIDER=smtp        # smtp (local) or resend (production)
STASH_EMAIL_FROM=noreply@stash.local
STASH_EMAIL_FROM_NAME=Stash
RESEND_API_KEY=                  # required when STASH_EMAIL_PROVIDER=resend
STASH_BASE_URL=http://localhost:8080
SMTP_HOST=localhost
SMTP_PORT=1025
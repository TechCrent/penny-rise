# payments-service/.env.example

PAYMENTS_DB_HOST=localhost
PAYMENTS_DB_PORT=15433
PAYMENTS_DB_NAME=payments_db
PAYMENTS_DB_USER=stash_payments
PAYMENTS_DB_PASSWORD=change_me_payments

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=stash
RABBITMQ_PASSWORD=change_me_rabbitmq

# Paystack — sk_test_... for test mode, sk_live_... for live
PAYSTACK_SECRET_KEY=sk_test_change_me_paystack

# Moolre — sandbox does not require api-key / api-pubkey
MOOLRE_BASE_URL=https://sandbox.moolre.com
MOOLRE_API_USER=change_me_moolre_user
MOOLRE_API_KEY=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=change_me_moolre_account
MOOLRE_WEBHOOK_SECRET=
MOOLRE_SANDBOX=true
MOOLRE_SETTLEMENT_ACCOUNT_ID=00000000-0000-0000-0000-000000000004

SPRING_PROFILES_ACTIVE=local

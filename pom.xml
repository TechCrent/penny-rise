<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
           https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.stash</groupId>
    <artifactId>stash-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Stash Parent</name>

    <modules>
        <!-- Shared libraries (no Spring Boot, plain Java) -->
        <module>shared/uuid-v7</module>
        <module>shared/money</module>
        <module>shared/time</module>
        <module>shared/events-java</module>
        <module>shared/api-errors</module>

        <!-- Backend services -->
        <module>monolith</module>
        <module>payments-service</module>
        <module>kyc-service</module>
        <module>audit-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.boot.version>3.3.0</spring.boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Internal shared modules -->
            <dependency>
                <groupId>com.stash</groupId>
                <artifactId>uuid-v7</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stash</groupId>
                <artifactId>money</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stash</groupId>
                <artifactId>time</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stash</groupId>
                <artifactId>events-java</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stash</groupId>
                <artifactId>api-errors</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>3.25.3</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring.boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>